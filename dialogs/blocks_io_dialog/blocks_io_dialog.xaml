<Window x:Class="NanoCadIO.BlocksIoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Импорт/Экспорт блоков в Excel"
        Width="500" Height="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Фильтр по имени блока -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Label Content="Имя блока (пусто = все):" VerticalAlignment="Center"/>
            <TextBox x:Name="BlockNameTextBox" Width="200" Margin="8,0,0,0" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="ExportButton" Content="Экспорт в Excel" Width="140" Height="30" Margin="0,0,8,0" Click="ExportButton_Click"/>
            <Button x:Name="ImportButton" Content="Импорт из Excel" Width="140" Height="30" Click="ImportButton_Click"/>
        </StackPanel>

        <!-- Лог -->
        <TextBox Grid.Row="2" x:Name="LogTextBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
    </Grid>
</Window>
