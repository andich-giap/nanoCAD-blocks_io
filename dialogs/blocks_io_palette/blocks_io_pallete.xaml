<UserControl x:Class="NanoCadIO.BlocksIoPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="100"/> <!-- Лог -->
        </Grid.RowDefinitions>

        <!-- Кнопка обновления списка блоков -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="RefreshBtn" Content="Обновить список блоков" Width="180" Height="26" Click="RefreshBtn_Click"/>
        </StackPanel>

        <!-- Список блоков с чекбоксами -->
        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" Margin="0,0,0,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="BlocksList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding BlockName}" 
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                      Margin="4,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="ExportBtn" Content="Экспорт выбранных" Width="140" Height="30" Margin="0,0,8,0" Click="ExportBtn_Click"/>
            <Button x:Name="ImportBtn" Content="Импорт из Excel" Width="140" Height="30" Click="ImportBtn_Click"/>
        </StackPanel>

        <!-- Лог -->
        <TextBox Grid.Row="3" x:Name="LogTextBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
    </Grid>
</UserControl>
