<!-- dialogs/blocks_io_palette/blocks_io_pallete.xaml -->
<UserControl x:Class="NanoCadIO.BlocksIoPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Кнопка обновления списка блоков (только иконка, без текста) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="RefreshBtn" Width="28" Height="28" Padding="4"
                    Click="RefreshBtn_Click" ToolTip="Обновить список блоков">
                <Path Fill="DimGray" Stretch="Uniform" Width="14" Height="14"
                      Data="M17.65,6.35C16.2,4.9 14.21,4 12,4c-4.42,0 -7.99,3.58 -7.99,8s3.57,8 7.99,8c3.73,0 6.84,-2.55 7.73,-6h-2.08c-0.82,2.33 -3.04,4 -5.65,4 -3.31,0 -6,-2.69 -6,-6s2.69,-6 6,-6c1.66,0 3.14,0.69 4.22,1.78L13,11h7V4l-2.35,2.35z"/>
            </Button>
        </StackPanel>

        <!-- Список блоков с чекбоксами -->
        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" Margin="0,0,0,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="BlocksList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding BlockName}" 
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                      Margin="4,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button x:Name="ExportBtn" Content="Экспорт выбранных" Width="140" Height="30" Margin="0,0,8,0" Click="ExportBtn_Click"/>
            <Button x:Name="ImportBtn" Content="Импорт из Excel" Width="140" Height="30" Click="ImportBtn_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
