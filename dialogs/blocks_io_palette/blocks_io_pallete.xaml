<!-- dialogs/blocks_io_palette/blocks_io_pallete.xaml -->
<UserControl x:Class="NanoCadIO.BlocksIoPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="350">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- поиск + массовые действия -->
            <RowDefinition Height="*"/>    <!-- список -->
            <RowDefinition Height="Auto"/> <!-- счётчики -->
            <RowDefinition Height="Auto"/> <!-- статус -->
            <RowDefinition Height="Auto"/> <!-- кнопки -->
        </Grid.RowDefinitions>

        <!-- Row 0: поиск + массовые действия -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     Margin="0,0,4,0"
                     Height="24"
                     VerticalContentAlignment="Center"
                     ToolTip="Поиск по имени блока"
                     TextChanged="SearchBox_TextChanged"/>
            <Button x:Name="InvertBtn"
                    Grid.Column="1"
                    Content="Инверсия"
                    MinWidth="64" Height="24" Margin="0,0,4,0"
                    ToolTip="Инвертировать отметки у видимых блоков"
                    Click="InvertBtn_Click"/>
            <Button x:Name="SelectAllBtn"
                    Grid.Column="2"
                    Content="Все"
                    MinWidth="48" Height="24" Margin="0,0,4,0"
                    ToolTip="Отметить все видимые блоки"
                    Click="SelectAllBtn_Click"/>
            <Button x:Name="ClearAllBtn"
                    Grid.Column="3"
                    Content="Ничего"
                    MinWidth="48" Height="24"
                    ToolTip="Снять отметки со всех видимых блоков"
                    Click="ClearAllBtn_Click"/>
        </Grid>

        <!-- Row 1: список блоков -->
        <ListBox x:Name="BlocksList"
                 Grid.Row="1"
                 Margin="0,0,0,6"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              Margin="4,2"
                              VerticalContentAlignment="Center">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInSelection}" Value="True">
                                        <Setter Property="ToolTip" Value="Присутствует в текущем выделении чертежа"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Row 2: счётчики -->
        <TextBlock x:Name="CountsLabel"
                   Grid.Row="2"
                   Margin="0,0,0,4"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>

        <!-- Row 3: статус последней операции -->
        <TextBlock x:Name="StatusLabel"
                   Grid.Row="3"
                   Margin="0,0,0,6"
                   TextWrapping="Wrap"
                   MaxHeight="44"
                   VerticalAlignment="Top"/>

        <!-- Row 4: действия -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="RefreshBtn"
                    Grid.Column="0"
                    Content="Обновить"
                    MinWidth="90" Height="30" Margin="0,0,6,0"
                    ToolTip="Перечитать список блоков из чертежа"
                    Click="RefreshBtn_Click"/>
            <Button x:Name="ExportBtn"
                    Grid.Column="1"
                    Content="Экспорт из выделения"
                    Height="30" Margin="0,0,6,0"
                    HorizontalAlignment="Stretch"
                    ToolTip="Выгрузить отмеченные блоки из текущего выделения в Excel"
                    Click="ExportBtn_Click"/>
            <Button x:Name="ImportBtn"
                    Grid.Column="2"
                    Content="Импорт из Excel"
                    MinWidth="130" Height="30"
                    ToolTip="Загрузить значения из Excel и применить к блокам чертежа"
                    Click="ImportBtn_Click"/>
        </Grid>
    </Grid>
</UserControl>
